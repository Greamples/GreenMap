{
  "schemaVersion": 1,
  "id": "greenmap",
  "version": "${version}",
  "name": "GreenMap",
  "description": "Collects loaded chunks as resource-pack independent data for a shared server map",
  "authors": [
    "Greamples"
  ],
  "contact": {},
  "license": "All-Rights-Reserved",
  "environment": "client",
  "entrypoints": {
    "client": [
      "org.greamples.greenmap.client.GreenMapClient"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-language-kotlin": ">=${kotlin_loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  }
}
